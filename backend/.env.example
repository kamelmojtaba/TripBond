# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co

# SUPABASE_KEY: Deprecated, kept for backward compatibility
# Will be used as SERVICE_ROLE_KEY if SUPABASE_SERVICE_ROLE_KEY is not set
SUPABASE_KEY=your-service-role-key-here

# SUPABASE_ANON_KEY: Public anon key (required) - Used for RLS-enabled operations
# Get this from: Supabase Dashboard > Settings > API > Project API keys > anon public
SUPABASE_ANON_KEY=your-anon-key-here

# SUPABASE_SERVICE_ROLE_KEY: Service role key (optional) - Bypasses RLS
# Only needed for admin operations. If not set, SUPABASE_KEY will be used.
# Get this from: Supabase Dashboard > Settings > API > Project API keys > service_role secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret for authentication
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Google Maps / Places API (Primary - Used for places search, nearby search, and photos)
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable: "Places API" in your GCP project
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# TomTom Search & Places API (Deprecated - Use Google Maps instead)
# Get your key from: https://developer.tomtom.com/
# TOMTOM_API_KEY=your-tomtom-api-key-here

# Geoapify Places API (Alternative fallback)
# Get your key from: https://www.geoapify.com/
# GEOAPIFY_API_KEY=your-geoapify-api-key-here

# AI model path used by startup readiness check
# Example points to placeholder model file in this repository
MODEL_PATH=../ai/models/tripbond_model.bin

# SMTP Configuration (for email notifications)
# For Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your@gmail.com
